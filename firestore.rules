rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function available() { let d = get(/databases/$(database)/documents/_system/database).data; return d.metadataVersion == 1 && d.schemaVersion == 2 && d.status == "ready"; }
  match /_system/database { allow get: if request.auth != null; allow write: if false; }
  function authenticatedOwner(uid) { return request.auth != null && request.auth.uid == uid; }
  function controlPath(uid) { return /databases/$(database)/documents/users/$(uid)/_journal/control; }
  function readReady(uid) { return !exists(controlPath(uid)) || get(controlPath(uid)).data.state != 'import' || get(controlPath(uid)).data.phase in ['preparing','verifying','verifyingRollback']; }
  function writeReady(uid) { return !exists(controlPath(uid)) || get(controlPath(uid)).data.state == 'ready' || (get(controlPath(uid)).data.state == 'snapshot' && get(controlPath(uid)).data.expiresAt <= request.time); }
  function owner(uid) { return available() && authenticatedOwner(uid) && readReady(uid); }
  function writer(uid) { return available() && authenticatedOwner(uid) && request.auth.token.email_verified == true && writeReady(uid); }
  function admission() { return !get(/databases/$(database)/documents/_system/database).data.get('importsBlocked',false); }
  function sessionPath(uid,id) { return /databases/$(database)/documents/users/$(uid)/imports/$(id); }
  function checkpointMoved(uid) {
   let before=get(controlPath(uid)).data; let after=getAfter(controlPath(uid)).data;
   return available() && authenticatedOwner(uid) && request.auth.token.email_verified == true && before.state=='import' && before.expiresAt>request.time && before.owner==after.owner && before.fence==after.fence && after.checkpoint==before.checkpoint+1;
  }
  function transferTarget(uid,key,deleting) {
   let c=get(controlPath(uid)).data;
   let row=get(/databases/$(database)/documents/users/$(uid)/imports/$(c.operationId)/records/$(key)).data;
   let target=c.phase=='rollingBack' ? row.restore : row.after;
   return row.apply && (deleting ? target==null : target==request.resource.data);
  }
  function transferWrite(uid,key,deleting) {
   return exists(controlPath(uid)) && get(controlPath(uid)).data.state=='import'
    && get(controlPath(uid)).data.phase in ['applying','rollingBack']
    && checkpointMoved(uid) && transferTarget(uid,key,deleting);
  }
  function completedTransfer(uid,id) {
   let session=getAfter(sessionPath(uid,id)).data;
   return session.status in ['complete','rolledBack','rejected'] && (session.get('kind','import')!='accountDeletion' || session.get('cleanupComplete',false)==true);
  }
  match /users/{uid}/_journal/control {
   allow get: if authenticatedOwner(uid);
   allow create,update: if available() && authenticatedOwner(uid) && request.resource.data.keys().hasOnly(['state','operationId','owner','fence','expiresAt','phase','cursor','checkpoint']) && request.resource.data.state in ['ready','snapshot','import'] && request.resource.data.expiresAt is timestamp && request.resource.data.expiresAt<=request.time+duration.value(180,'s') && request.resource.data.owner is string && request.resource.data.fence is int && request.resource.data.checkpoint is int && request.resource.data.cursor is int && request.resource.data.cursor>=0
    && (request.resource.data.state!='import' || request.auth.token.email_verified==true)
    && ((!exists(controlPath(uid)) && admission() && request.resource.data.fence==1 && request.resource.data.checkpoint==1)
     || (exists(controlPath(uid)) && ((request.resource.data.owner==resource.data.owner && request.resource.data.fence==resource.data.fence && resource.data.expiresAt>request.time && request.resource.data.checkpoint in [resource.data.checkpoint,resource.data.checkpoint+1] && request.resource.data.operationId==resource.data.operationId)
      || (admission() && request.resource.data.fence==resource.data.fence+1 && request.resource.data.checkpoint==resource.data.checkpoint+1 && (resource.data.state=='ready' || (resource.data.state=='snapshot' && resource.data.expiresAt<=request.time) || (resource.data.state=='import' && resource.data.operationId==request.resource.data.operationId && (resource.data.owner==request.resource.data.owner || resource.data.expiresAt<=request.time)))))))
    && (request.resource.data.state!='ready' || !exists(controlPath(uid)) || resource.data.state!='import' || completedTransfer(uid,resource.data.operationId));
  }
  function deletionTransition(uid,id,d) {
   let old=get(sessionPath(uid,id)).data;
   return (d.status==old.status && (old.status in ['complete','rolledBack','rejected'] ? d.diff(old).affectedKeys().hasOnly(['cleanupComplete']) : checkpointMoved(uid)))
    || (old.status=='uploaded' && d.status=='rolledBack')
    || (checkpointMoved(uid) && ((old.status=='uploaded' && d.status=='preparing')
      || (old.status=='preparing' && d.status in ['applying','rolledBack','rejected'])
      || (old.status=='applying' && d.status in ['complete','preparingRollback'])
      || (old.status=='preparingRollback' && d.status=='rollingBack')
      || (old.status=='rollingBack' && d.status=='rolledBack')));
  }
  function deletionSession(uid,id,d) {
   return d.get('kind','import')!='accountDeletion' || (d.mode=='replace' && d.includeSettings==true && d.sourceChunks==0
    && d.accountId is string && d.accountId.matches('^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$') && d.accountRevision is int && d.accountRevision>0
    && (!(d.status in ['complete','rolledBack','rejected']) || d.backupAvailable==false)
    && (exists(sessionPath(uid,id)) ? deletionTransition(uid,id,d) : (d.status=='uploaded' && exists(accountRef(uid,d.accountId)) && get(accountRef(uid,d.accountId)).data.archived && get(accountRef(uid,d.accountId)).data.revision==d.accountRevision)));
  }
  match /users/{uid}/imports/{id} {
   allow read: if authenticatedOwner(uid);
   allow create,update: if available() && authenticatedOwner(uid) && request.auth.token.email_verified==true && request.resource.data.id==id && request.resource.data.uid==uid && deletionSession(uid,id,request.resource.data) && request.resource.data.mode in ['add','replace'] && request.resource.data.get('kind','import') in ['import','accountDeletion'] && request.resource.data.status in ['uploading','uploaded','preparing','applying','preparingRollback','rollingBack','complete','rolledBack','rejected']
    && (!exists(sessionPath(uid,id)) || (request.resource.data.sourceFingerprint==resource.data.sourceFingerprint && request.resource.data.previewFingerprint==resource.data.previewFingerprint && request.resource.data.mode==resource.data.mode && request.resource.data.includeSettings==resource.data.includeSettings && request.resource.data.receiptId==resource.data.receiptId && request.resource.data.get('kind','import')==resource.data.get('kind','import') && request.resource.data.get('accountId',null)==resource.data.get('accountId',null) && request.resource.data.get('accountRevision',null)==resource.data.get('accountRevision',null) && (resource.data.status in ['uploading','uploaded'] || checkpointMoved(uid) || (resource.data.status in ['complete','rolledBack','rejected'] && request.resource.data.status==resource.data.status))));
   match /source/{chunk} {
    allow read: if authenticatedOwner(uid);
    allow create,update: if available() && authenticatedOwner(uid) && request.auth.token.email_verified==true && get(sessionPath(uid,id)).data.status=='uploading' && request.resource.data.index is int && request.resource.data.text is string && request.resource.data.text.size()<=65536;
    allow delete: if available() && authenticatedOwner(uid) && request.auth.token.email_verified==true && get(sessionPath(uid,id)).data.status in ['complete','rolledBack','rejected'];
   }
   match /records/{key} {
    allow read: if authenticatedOwner(uid);
    allow create,update: if checkpointMoved(uid) && get(controlPath(uid)).data.operationId==id && get(controlPath(uid)).data.phase in ['preparing','applying','preparingRollback','rollingBack'] && request.resource.data.path is string && request.resource.data.apply is bool && (!exists(/databases/$(database)/documents/users/$(uid)/imports/$(id)/records/$(key)) || (request.resource.data.before==resource.data.before && request.resource.data.after==resource.data.after));
    allow delete: if available() && authenticatedOwner(uid) && request.auth.token.email_verified==true && get(sessionPath(uid,id)).data.status in ['complete','rolledBack','rejected'] && !get(sessionPath(uid,id)).data.backupAvailable;
   }
  }
  function code(v) { return v is string && v.matches('^[A-Z][A-Z0-9]{2,11}$'); }
  function dec(v) { return v is string && v.size() <= 100 && v.matches('^-?[0-9]+([.][0-9]+)?$'); }
  function pos(v) { return dec(v) && v.matches('^[0-9]+([.][0-9]+)?$') && v.matches('.*[1-9].*'); }
  function optionalRate(v) { return v == null || pos(v); }
  function iso(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$'); }
  function shortText(v) { return v is string && v.size() <= 120; }
  function body(v) { return v is string && v.size() <= 10000; }
  function meta(uid,id) { let d=request.resource.data;return d.id == id && d.uid == uid && d.schemaVersion == 2 && d.revision is int && d.revision >= 1 && iso(d.createdAt) && iso(d.updatedAt); }
  function revision() { return request.resource.data.revision == resource.data.revision + 1 && request.resource.data.createdAt == resource.data.createdAt; }
  function accountRef(uid,id) { return /databases/$(database)/documents/users/$(uid)/accounts/$(id); }
  function archiveClearsDefault(uid,id) { let p=/databases/$(database)/documents/users/$(uid)/settings/preferences; return !existsAfter(p) || getAfter(p).data.defaultAccount!=id; }
  function tradeRef(uid,id) { return /databases/$(database)/documents/users/$(uid)/trades/$(id); }
  function activeTrade(uid,tid) { let a=accountRef(uid,get(tradeRef(uid,tid)).data.accountId); return exists(a) && !get(a).data.archived; }
  function activeTradeAfter(uid,tid) { let a=accountRef(uid,getAfter(tradeRef(uid,tid)).data.accountId); return existsAfter(a) && !getAfter(a).data.archived; }
  function parentChange(uid,tid) { return activeTradeAfter(uid,tid) && existsAfter(tradeRef(uid,tid)) && (!exists(tradeRef(uid,tid)) || getAfter(tradeRef(uid,tid)).data.revision == get(tradeRef(uid,tid)).data.revision + 1); }
  function correctionCreate(uid,tid,id) {
   let c=request.resource.data;
   return meta(uid,id) && c.keys().hasOnly(['id','uid','schemaVersion','calculationVersion','revision','createdAt','updatedAt','operationId','reason','changes'])
    && id==c.operationId && id.matches('^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$') && c.calculationVersion==1
    && c.updatedAt==c.createdAt && c.reason is string && c.reason.size()>0 && c.reason.size()<=1000 && c.reason.matches('(?s)\\S(?:.*\\S)?')
    && c.changes is list && c.changes.size()>0
    && existsAfter(tradeRef(uid,tid)) && activeTradeAfter(uid,tid) && c.revision==getAfter(tradeRef(uid,tid)).data.revision;
  }
  function parentDelete(uid,tid) { return activeTrade(uid,tid) && (!existsAfter(tradeRef(uid,tid)) || parentChange(uid,tid)); }
  function strategySnapshot(d) { return d.keys().hasOnly(['id','uid','schemaVersion','revision','createdAt','updatedAt','name','purpose','markets','entryRules','exitRules','riskRules','archived']) && d.schemaVersion==2 && d.revision is int && d.revision>=1 && iso(d.createdAt) && iso(d.updatedAt) && shortText(d.name) && d.name.size()>0 && body(d.purpose) && body(d.markets) && body(d.entryRules) && body(d.exitRules) && body(d.riskRules) && d.archived is bool; }
  function normalLeg(uid,tid,id) {
   let d=request.resource.data;
   let old=exists(/databases/$(database)/documents/users/$(uid)/trades/$(tid)/legs/$(id));
   let ref=/databases/$(database)/documents/users/$(uid)/instruments/$(d.instrumentId);
   return parentChange(uid,tid) && meta(uid,id)
    && d.keys().hasOnly(['id','uid','schemaVersion','revision','createdAt','updatedAt','instrumentId','snapshot','direction','planning'])
    && d.direction in ['long','short'] && d.planning is map
    && d.snapshot.id==d.instrumentId && d.snapshot.uid==uid && !d.snapshot.draft
    && (old ? d.instrumentId==resource.data.instrumentId && savedSnapshot(d.snapshot)
     : exists(ref) && !get(ref).data.archived && !get(ref).data.draft && d.snapshot==get(ref).data && instrument(d.snapshot));
  }
  function savedSnapshot(d) {
   return d==resource.data.snapshot || (d.diff(resource.data.snapshot).affectedKeys().hasOnly(['pointValue'])
    ? (pos(d.pointValue) || (d.pointValue==null && (d.draft || d.model=='manual')))
    : (d.diff(resource.data.snapshot).affectedKeys().hasOnly(['currency']) ? code(d.currency) : instrument(d)));
  }
  function instrument(d) {
   return shortText(d.name) && d.name.size()>0 && shortText(d.symbol) && shortText(d.market) && shortText(d.venue) && d.preset in ['equity','forex','futures','options','crypto','cryptoDerivative','cfd','custom'] && d.model in ['linear','manual'] && d.draft is bool && d.archived is bool && shortText(d.quantityUnit)
    && (!('priceUnit' in d) || (d.priceUnit is string && d.priceUnit.size()<=80))
    && optionalRate(d.pointValue) && optionalRate(d.quantityIncrement) && optionalRate(d.priceIncrement) && (d.currency==null || code(d.currency))
    && (d.draft || (d.symbol.size()>0 && d.market.size()>0 && d.quantityUnit.size()>0 && d.quantityIncrement!=null && d.priceIncrement!=null && d.currency!=null && (d.model=='manual' || d.pointValue!=null))) && shortText(d.underlying) && d.expiry is string && (d.strike==null || dec(d.strike)) && d.optionType in ['','call','put'];
  }
  function execution(d,uid,tid) {
   return d.keys().hasOnly(['id','uid','schemaVersion','revision','createdAt','updatedAt','legId','kind','quantity','price','timestamp','fees','feeCurrency','feeRate','resultRate','manualGross','manualSource','orderReference','reason','sequence']) && existsAfter(/databases/$(database)/documents/users/$(uid)/trades/$(tid)/legs/$(d.legId)) && d.kind in ['entry','exit','settlement'] && pos(d.quantity) && (dec(d.price) || (d.kind=='settlement' && d.price==null)) && dec(d.fees) && d.fees.matches('^[0-9]+([.][0-9]+)?$') && code(d.feeCurrency) && iso(d.timestamp) && optionalRate(d.get('feeRate',null)) && optionalRate(d.get('resultRate',null)) && (d.get('manualGross',null)==null || dec(d.manualGross));
  }
  function normalExecution(uid,tid,id) {
   let d=request.resource.data;
   return parentChange(uid,tid) && meta(uid,id)
    && existsAfter(/databases/$(database)/documents/users/$(uid)/trades/$(tid)/legs/$(d.legId))
    && (resource!=null && d.diff(resource.data).affectedKeys().hasOnly(['revision','updatedAt','resultRate'])
     ? optionalRate(d.get('resultRate',null)) : execution(d,uid,tid));
  }
  match /users/{uid}/accounts/{id} {
   allow read: if owner(uid);
   allow create,update: if writer(uid) && (!request.resource.data.archived || archiveClearsDefault(uid,id)) && meta(uid,id) && request.resource.data.keys().hasOnly(['id','uid','schemaVersion','revision','createdAt','updatedAt','name','currency','archived','hasTrades']) && shortText(request.resource.data.name) && request.resource.data.name.size()>0 && code(request.resource.data.currency) && request.resource.data.archived is bool && request.resource.data.hasTrades is bool && (!exists(accountRef(uid,id)) || (revision() && (!resource.data.hasTrades || (request.resource.data.hasTrades && request.resource.data.currency==resource.data.currency))));
   allow create,update: if transferWrite(uid,'accounts~'+id,false) && meta(uid,id) && request.resource.data.keys().hasOnly(['id','uid','schemaVersion','revision','createdAt','updatedAt','name','currency','archived','hasTrades']) && shortText(request.resource.data.name) && request.resource.data.name.size()>0 && code(request.resource.data.currency) && request.resource.data.archived is bool && request.resource.data.hasTrades is bool;
   allow delete: if transferWrite(uid,'accounts~'+id,true);
   allow delete: if false;
  }
  match /users/{uid}/instruments/{id} {
   allow read: if owner(uid);
   allow create,update: if ((writer(uid) && (!exists(/databases/$(database)/documents/users/$(uid)/instruments/$(id)) || revision())) || transferWrite(uid,'instruments~'+id,false)) && meta(uid,id) && instrument(request.resource.data) && request.resource.data.keys().hasOnly(['id','uid','schemaVersion','revision','createdAt','updatedAt','name','symbol','market','venue','preset','model','quantityUnit','priceUnit','quantityIncrement','priceIncrement','pointValue','currency','underlying','expiry','strike','optionType','draft','archived','lastUsedAt']);
   allow delete: if transferWrite(uid,'instruments~'+id,true);
   allow delete: if false;
  }
  match /users/{uid}/strategies/{id} {
   allow read: if owner(uid);
   allow create,update: if writer(uid) && meta(uid,id) && request.resource.data.keys().hasOnly(['id','uid','schemaVersion','revision','createdAt','updatedAt','name','purpose','markets','entryRules','exitRules','riskRules','archived']) && shortText(request.resource.data.name) && request.resource.data.name.size()>0 && body(request.resource.data.purpose) && body(request.resource.data.markets) && body(request.resource.data.entryRules) && body(request.resource.data.exitRules) && body(request.resource.data.riskRules) && request.resource.data.archived is bool && (!exists(/databases/$(database)/documents/users/$(uid)/strategies/$(id)) || revision());
   allow create,update: if transferWrite(uid,'strategies~'+id,false) && meta(uid,id) && request.resource.data.keys().hasOnly(['id','uid','schemaVersion','revision','createdAt','updatedAt','name','purpose','markets','entryRules','exitRules','riskRules','archived']) && shortText(request.resource.data.name) && request.resource.data.name.size()>0 && body(request.resource.data.purpose) && body(request.resource.data.markets) && body(request.resource.data.entryRules) && body(request.resource.data.exitRules) && body(request.resource.data.riskRules) && request.resource.data.archived is bool;
   allow delete: if transferWrite(uid,'strategies~'+id,true);
   allow delete: if false;
  }
  match /users/{uid}/settings/{id} {
   allow read: if owner(uid);
   allow create,update: if writer(uid) && id=='preferences' && meta(uid,id) && request.resource.data.keys().hasOnly(['id','uid','schemaVersion','revision','createdAt','updatedAt','theme','timezone','defaultAccount']) && request.resource.data.theme in ['system','light','dark'] && shortText(request.resource.data.timezone) && (request.resource.data.defaultAccount==null || (existsAfter(accountRef(uid,request.resource.data.defaultAccount)) && !getAfter(accountRef(uid,request.resource.data.defaultAccount)).data.archived)) && (!exists(/databases/$(database)/documents/users/$(uid)/settings/$(id)) || revision());
   allow create,update: if transferWrite(uid,'settings~'+id,false) && id=='preferences' && meta(uid,id) && request.resource.data.keys().hasOnly(['id','uid','schemaVersion','revision','createdAt','updatedAt','theme','timezone','defaultAccount']) && request.resource.data.theme in ['system','light','dark'] && shortText(request.resource.data.timezone) && (request.resource.data.defaultAccount==null || existsAfter(accountRef(uid,request.resource.data.defaultAccount)));
   allow delete: if transferWrite(uid,'settings~'+id,true);
  }
  match /users/{uid}/trades/{tid} {
   allow read: if owner(uid);
   allow create,update: if writer(uid) && activeTradeAfter(uid,tid) && meta(uid,tid) && request.resource.data.keys().hasOnly(['id','uid','schemaVersion','revision','createdAt','updatedAt','accountId','accountCurrency','strategyId','strategySnapshot','rationale','review','tags','riskBudget','status','summary','openedAt','instruments','lastOperation']) && exists(accountRef(uid,request.resource.data.accountId)) && request.resource.data.accountCurrency == get(accountRef(uid,request.resource.data.accountId)).data.currency && getAfter(accountRef(uid,request.resource.data.accountId)).data.hasTrades && body(request.resource.data.rationale) && body(request.resource.data.review) && request.resource.data.tags is list && request.resource.data.tags.size()<=30 && optionalRate(request.resource.data.riskBudget) && request.resource.data.status in ['open','closed'] && request.resource.data.summary is map && (request.resource.data.strategyId==null || (exists(/databases/$(database)/documents/users/$(uid)/strategies/$(request.resource.data.strategyId)) && request.resource.data.strategySnapshot.id==request.resource.data.strategyId && request.resource.data.strategySnapshot.uid==uid && ((exists(tradeRef(uid,tid)) && resource.data.strategyId==request.resource.data.strategyId && request.resource.data.strategySnapshot==resource.data.strategySnapshot) || ((!exists(tradeRef(uid,tid)) || resource.data.strategyId!=request.resource.data.strategyId) && !get(/databases/$(database)/documents/users/$(uid)/strategies/$(request.resource.data.strategyId)).data.archived && request.resource.data.strategySnapshot==get(/databases/$(database)/documents/users/$(uid)/strategies/$(request.resource.data.strategyId)).data)))) && ((!exists(tradeRef(uid,tid)) && !get(accountRef(uid,request.resource.data.accountId)).data.archived) || (revision() && request.resource.data.accountId==resource.data.accountId));
   allow create,update: if transferWrite(uid,'trades~'+tid,false) && meta(uid,tid) && request.resource.data.keys().hasOnly(['id','uid','schemaVersion','revision','createdAt','updatedAt','accountId','accountCurrency','strategyId','strategySnapshot','rationale','review','tags','riskBudget','status','summary','openedAt','instruments','lastOperation']) && exists(accountRef(uid,request.resource.data.accountId)) && request.resource.data.accountCurrency == get(accountRef(uid,request.resource.data.accountId)).data.currency && getAfter(accountRef(uid,request.resource.data.accountId)).data.hasTrades && body(request.resource.data.rationale) && body(request.resource.data.review) && request.resource.data.tags is list && request.resource.data.tags.size()<=30 && optionalRate(request.resource.data.riskBudget) && request.resource.data.status in ['open','closed'] && request.resource.data.summary is map && (request.resource.data.strategyId==null ? request.resource.data.strategySnapshot==null : (existsAfter(/databases/$(database)/documents/users/$(uid)/strategies/$(request.resource.data.strategyId)) && request.resource.data.strategySnapshot.id==request.resource.data.strategyId && request.resource.data.strategySnapshot.uid==uid && strategySnapshot(request.resource.data.strategySnapshot)));
   allow delete: if transferWrite(uid,'trades~'+tid,true);
   allow delete: if writer(uid) && activeTrade(uid,tid);
   match /legs/{id} {
    allow read: if owner(uid);
    allow create,update: if writer(uid) && normalLeg(uid,tid,id);
    allow create,update: if transferWrite(uid,'trades~'+tid+'~legs~'+id,false) && existsAfter(tradeRef(uid,tid)) && meta(uid,id) && request.resource.data.keys().hasOnly(['id','uid','schemaVersion','revision','createdAt','updatedAt','instrumentId','snapshot','direction','planning']) && request.resource.data.direction in ['long','short'] && request.resource.data.planning is map && exists(/databases/$(database)/documents/users/$(uid)/instruments/$(request.resource.data.instrumentId)) && request.resource.data.snapshot.id==request.resource.data.instrumentId && request.resource.data.snapshot.uid==uid && instrument(request.resource.data.snapshot) && !request.resource.data.snapshot.draft;
    allow delete: if transferWrite(uid,'trades~'+tid+'~legs~'+id,true);
    allow delete: if writer(uid) && parentDelete(uid,tid);
   }
   match /executions/{id} {
    allow read: if owner(uid);
    allow create,update: if writer(uid) && normalExecution(uid,tid,id);
    allow create,update: if transferWrite(uid,'trades~'+tid+'~executions~'+id,false) && existsAfter(tradeRef(uid,tid)) && meta(uid,id) && execution(request.resource.data,uid,tid);
    allow delete: if transferWrite(uid,'trades~'+tid+'~executions~'+id,true);
    allow delete: if writer(uid) && parentDelete(uid,tid);
   }
   match /adjustments/{id} {
    allow read: if owner(uid);
    allow create,update: if writer(uid) && parentChange(uid,tid) && meta(uid,id) && request.resource.data.keys().hasOnly(['id','uid','schemaVersion','revision','createdAt','updatedAt','amount','currency','rate','timestamp','reason']) && dec(request.resource.data.amount) && code(request.resource.data.currency) && optionalRate(request.resource.data.rate) && iso(request.resource.data.timestamp) && body(request.resource.data.reason) && request.resource.data.reason.size()>0;
    allow create,update: if transferWrite(uid,'trades~'+tid+'~adjustments~'+id,false) && existsAfter(tradeRef(uid,tid)) && meta(uid,id) && request.resource.data.keys().hasOnly(['id','uid','schemaVersion','revision','createdAt','updatedAt','amount','currency','rate','timestamp','reason']) && dec(request.resource.data.amount) && code(request.resource.data.currency) && optionalRate(request.resource.data.rate) && iso(request.resource.data.timestamp) && body(request.resource.data.reason) && request.resource.data.reason.size()>0;
    allow delete: if transferWrite(uid,'trades~'+tid+'~adjustments~'+id,true);
    allow delete: if writer(uid) && parentDelete(uid,tid);
   }
   match /corrections/{id} {
    allow read: if owner(uid);
    allow create: if writer(uid) && correctionCreate(uid,tid,id);
    allow create,update: if transferWrite(uid,'trades~'+tid+'~corrections~'+id,false) && request.resource.data.uid==uid && request.resource.data.id==id && request.resource.data.schemaVersion==2;
    allow delete: if transferWrite(uid,'trades~'+tid+'~corrections~'+id,true) || (writer(uid) && activeTrade(uid,tid) && !existsAfter(tradeRef(uid,tid)));
   }
   match /operations/{id} {
    allow read: if owner(uid);
    allow create: if writer(uid) && parentChange(uid,tid) && request.resource.data.uid==uid && request.resource.data.id==id && request.resource.data.revision==getAfter(tradeRef(uid,tid)).data.revision;
    allow create,update: if transferWrite(uid,'trades~'+tid+'~operations~'+id,false) && request.resource.data.uid==uid && request.resource.data.id==id && request.resource.data.revision is int && request.resource.data.revision>=1;
    allow delete: if transferWrite(uid,'trades~'+tid+'~operations~'+id,true);
    allow delete: if writer(uid) && activeTrade(uid,tid) && !existsAfter(tradeRef(uid,tid));
   }
  }
 }
}
