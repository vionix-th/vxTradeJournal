{
  "name": "vx-trade-journal",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "schema:manifest": "node scripts/migration-manifest.js",
    "schema:manifest:check": "node scripts/migration-manifest.js --check",
    "dev": "node scripts/dev.js",
    "dev:test": "node scripts/dev.js --profile test",
    "emulators": "node scripts/emulators.js",
    "cli": "node src/cli/index.js",
    "skill:build": "node scripts/build-skill.js",
    "skill:docs": "node scripts/skill-docs.js",
    "skill:docs:check": "node scripts/skill-docs.js --check",
    "prebuild": "npm run skill:build",
    "build": "vite build",
    "prebuild:prod": "npm run skill:build",
    "build:prod": "vite build --mode hosted",
    "preview:prod": "vite preview --mode hosted --host 127.0.0.1",
    "deploy:prod": "node scripts/database.js deploy --profile prod",
    "deploy:rules": "node scripts/database.js deploy --profile prod",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node scripts/test.js all",
    "test:unit": "node scripts/test.js unit",
    "test:integration": "node scripts/test.js integration",
    "test:e2e": "node scripts/test.js e2e",
    "test:cli": "node scripts/test.js cli",
    "test:skill": "node scripts/test-skill.js",
    "test:watch": "vitest --config vitest.config.js --project unit",
    "lint": "eslint .",
    "data:seed": "node scripts/data.js seed",
    "data:reset": "node scripts/data.js reset",
    "check": "npm run lint && npm run skill:docs:check && npm test && npm run build && npm run test:skill",
    "database:status": "node scripts/database.js status",
    "database:restore": "node scripts/database.js restore",
    "database:upgrade": "node scripts/database.js upgrade"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "decimal.js": "^10.6.0",
    "firebase": "^12.4.0"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.13.6"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.55.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "fflate": "^0.8.3",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.32.1",
    "globals": "^16.5.0",
    "jsqr": "^1.4.0",
    "qrcode-generator": "^2.0.4",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
